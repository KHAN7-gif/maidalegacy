# Copy to .env for local development. On Hostinger, the managed MySQL
# credentials below are usually auto-injected by hPanel — check the Node.js
# app's environment variables panel for the exact names and prefer those
# over hardcoding here. API_SHARED_KEY must always be set manually.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mde_finance

# Long random string — must match API_KEY in public/index.html (search for
# "API_KEY" near the old FB_CONFIG block). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SHARED_KEY=change-me-to-a-long-random-string

# Only needed once, when running `npm run migrate` to import the existing
# Firebase Realtime Database export.
FIREBASE_DATABASE_URL=https://maidalegacy-1fe56-default-rtdb.asia-southeast1.firebasedatabase.app
